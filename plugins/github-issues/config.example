# ---------------------------------------------------------------------
# What this plugin depends on, and that it is met.
#
# It is the first intake that carries text a stranger wrote into an
# agent, so every task it files carries public trust, and the
# `[trust.public]` policy is the condition it runs under (docs/PLUGINS.md,
# "Trust levels"; docs/GTM.md item 1). By default that policy is:
#   - a daily cap: at most 5 public tasks in 24 hours, the rest wait;
#   - a small budget (1.00 USD) and only the "reviewed" workflow;
#   - model-only egress: the attempt's network namespace reaches the
#     model endpoint and nothing else, not even the hosts the target
#     repository's forge.toml declares in [sandbox] egress;
#   - a human landing: the task ends unverified with its branch pushed
#     and never lands itself; land it with `forge land <task>`.
# The agent cannot push (its clone has no remote and its home is an empty
# tmpfs), and Forge quotes the issue body and tells the model it is data,
# which is a mitigation; the trust policy is the boundary. `forge doctor`
# reports each project's policy (WARN when FORGE_SANDBOX=0, which lifts
# it). Loosen it only in `[trust.public]` of your config.toml, knowing what
# each field lets a stranger's text do.
#
# The model token is still the operator's, not scoped to the task
# (docs/GTM.md item 1). It can reach only the model endpoint.
# ---------------------------------------------------------------------

# Copy this file to "config" next to plugin.toml (or into the installed
# copy under FORGE_HOME/plugins/github-issues/) and fill it in. It is
# shell, sourced by github-issues.sh: KEY=value lines, one per line.

# owner/name of the GitHub repository to watch. Required.
GH_REPO=owner/name

# Only open issues carrying this label are filed as tasks.
LABEL=forge

# Added to the issue when its task lands. Unset (the default) skips
# labeling.
#DONE_LABEL=forge-done

# How often to check GH_REPO for new issues, in seconds. Never less than
# 30, regardless of what is set here.
POLL_SECONDS=120

# Local path to the git repository new tasks are queued against.
# Required.
TARGET_REPO=/path/to/repo

# The workflow new tasks run (see `forge workflows`). Every task this
# plugin files carries public trust, whose default policy allows only
# "reviewed" (see `[trust.public]` in the operator's config.toml); naming
# a stricter workflow here than that policy allows fails every task at
# the door.
WORKFLOW=reviewed
