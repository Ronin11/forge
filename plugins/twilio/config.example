# Copy to $FORGE_PLUGIN_DIR/config (KEY=value, one per line, '#' comments
# and blank lines ignored). Nothing here is parsed as shell. Once copied,
# chmod 600 this file: twilio.sh refuses to run against a config that is
# readable or writable by group or other.

# Twilio's REST API credentials (console.twilio.com, Account ->
# API keys & tokens). Prefer an API key pair over the account's own auth
# token, since a key can be revoked on its own without rotating every
# other thing that uses the account's credentials; either pair
# authenticates every call below. Leave the pair you don't use blank.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Total monthly rental Forge may hold across every number it owns, in
# USD. `buy` refuses a purchase that would push the total (every owned
# number's own price, plus the one being bought) over this.
MONTHLY_CAP_USD=5

# How many numbers Forge may hold at once. `buy` refuses past this,
# regardless of cost.
MAX_NUMBERS=2

# Country to search and buy in, Twilio's ISO country code (e.g. US, GB).
COUNTRY=US

# The inbound SMS loop (docs/PLUGINS.md): every POLL_SECS, each owned
# number's new messages are fetched, recorded in the message record and
# routed. Reuses the Signal plugin's config names (plugins/signal/config.example)
# where the same idea applies.

# How often to poll for new inbound messages.
POLL_SECS=30

# Senders allowed to drive Forge over SMS (space-separated E.164
# numbers): a plain message queues work (`forge add TARGET_REPO
# <text>`), and `/answer <id> <text>` answers an open question. A
# message from anyone else is ignored (recorded and logged, nothing
# queued) unless it answers an open question addressed to a CONTACTS
# name (see below).
ALLOWED=+15555550199

# Intake's addressee mechanism (docs/INTAKE.md): a blocked question can
# name who it is for. When that name matches one here, a reply from
# their number while their question is open is submitted as their
# answer (`forge answer ID TEXT --by NAME`), not queued as a new task.
# Space-separated "name:number" pairs.
CONTACTS=alice:+15555550111

# Which project a CONTACTS name's plain message (not an answer to their
# open question) is routed to through the concierge (`forge ask`).
# Space-separated "name:project" pairs; a name this doesn't list falls
# to TARGET_REPO's own project.
PROJECTS=alice:demo

# Repo and workflow `forge add` uses for an ALLOWED sender's plain
# message; also PROJECTS' fallback project for a CONTACTS name's
# message.
TARGET_REPO=/path/to/repo
WORKFLOW=direct
