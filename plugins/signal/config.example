# Copy to $FORGE_PLUGIN_DIR/config (KEY=value, one per line, '#' comments
# and blank lines ignored). Nothing here is parsed as shell.

# The number this bot is registered as with signal-cli.
SIGNAL_ACCOUNT=+15555550100

# Who outbound notifications go to: a phone number or a group id.
SIGNAL_TO=+15555550199

# Senders allowed to drive Forge back over Signal (space-separated phone
# numbers). A message from anyone else is ignored and logged, unless it
# answers an open question addressed to them (see CONTACTS below).
SIGNAL_ALLOWED=+15555550199

# Intake's addressee mechanism (docs/INTAKE.md): a blocked question can
# name who it is for. When that name matches one here, the question is
# sent to their number instead of the operator's SIGNAL_TO, and a reply
# from that number while their question is open is submitted as their
# answer (`forge answer ID TEXT --by NAME`), not queued as a new task.
# Space-separated "name:number" pairs.
CONTACTS=alice:+15555550111

# Which project a CONTACTS name's plain message (not /answer, /status,
# /help, or an answer to their open question) is routed to: `forge ask`
# sorts it into a request, a question, a need, or unclear, and the
# reply goes back to them over Signal. Space-separated "name:project"
# pairs; a name this doesn't list falls to TARGET_REPO's own project.
PROJECTS=alice:demo

# How often to poll signal-cli for new messages.
POLL_SECONDS=30

# Repo and workflow `forge add` uses for a message from an allowed
# sender that isn't a command (see SIGNAL_ALLOWED above; filed at contact trust, which allows reviewed but not direct); also
# PROJECTS' fallback project for a CONTACTS name's message.
TARGET_REPO=/path/to/repo
WORKFLOW=reviewed

# Task states worth a Signal message, space-separated.
NOTIFY_ON=blocked failed

# A deploy that passes its check is quiet by default: a failed or
# rolled-back deploy always sends a message. Set to 1 to also message on
# a deploy that simply passed.
NOTIFY_DEPLOY_OK=0

# Where the operator's reverse proxy serves the customer portal (see
# docs/PORTAL.md), e.g. https://portal.example.com. A CONTACTS name gets
# their portal link at "$PORTAL_URL/p/<token>" by texting /portal, and
# automatically the first time `forge intake accept` creates their
# project. Left empty, the bare "/p/<token>" path is sent.
PORTAL_URL=
