# Forge worker as a user service. Install:
#   mkdir -p ~/.config/systemd/user && cp deploy/forge-worker.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now forge-worker
# Redeploy after a rebuild: systemctl --user restart forge-worker
# One SIGTERM drains (running attempts finish, nothing new is claimed), so the
# stop timeout is long enough for the longest attempt.
[Unit]
Description=Forge worker
After=network-online.target

[Service]
Type=simple
Environment=FORGE2_HOME=%h/.local/share/forge2
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/Projects/forge_2_electric_boogaloo/target/release/forge work --jobs 2
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=2400
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
